rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these admin accounts can write — the site has no public write
    // flows, so any authenticated user is too broad.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        '3PWUnLzDIWdkjqAr8IrSc3yC6Ge2',
        'YraL8Ico7heUiAbadXKICbP6V4I2',
      ];
    }
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
